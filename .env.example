SUPABASE_URL=https://smiamxvoztjmvjidmreh.supabase.co
# Clé service_role UNIQUEMENT en local, jamais dans git ni dans le frontend.
SUPABASE_SERVICE_ROLE=
# Optionnel : plus rapide que le dump NT si tu as une clé
# https://www.datatourisme.fr/utiliser-les-donnees
DATATOURISME_API_KEY=
# Comptes : persistés dans Supabase (même projet que le catalogue). data/accounts.json n’est qu’un cache local.
# Mail d’inscription. En ligne (Render bloque SMTP 25/465/587) :
# 1) RESEND_API_KEY (https://resend.com, gratuit) — obligatoire pour les nouveaux mails
#    si Supabase Auth ne peut pas créer d’utilisateur.
# 2) Sans Resend : Sinki tente l’email Auth Supabase (OTP) pour les users déjà dans Auth.
# En local, Sinki passe par Mail.app si Resend/SMTP manquent.
RESEND_API_KEY=
# Défaut Resend test : onboarding@resend.dev (example.com / sinki.app sont refusés).
MAIL_FROM=Sinki <onboarding@resend.dev>
# SMTP uniquement en local : Render le bloque.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
